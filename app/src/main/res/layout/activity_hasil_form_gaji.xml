<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INFORMASI GAJI PEGAWAI"
            android:textStyle="bold"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Data Pegawai"
            android:textStyle="bold"
            android:layout_gravity="left"
            />

        <TextView
            android:id="@+id/tvNIP"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NIP: -"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvNama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nama: -"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvTanggalLahir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tanggal Lahir: -"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvJamBayar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jam Bayar: -"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: -"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvJumlahAnak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jumlah Anak: -"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvGolongan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Golongan: -"
            android:textSize="16sp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#BDBDBD"
            android:layout_marginVertical="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rincian Gaji"
            android:textStyle="bold"
            android:layout_gravity="left"
            />

        <TextView
            android:id="@+id/tvGajiPokok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gaji Pokok: Rp 0"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvUangMakan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Uang Makan: Rp 0"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvLembur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lembur: Rp 0"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvDinasLuar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dinas Luar: Rp 0"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvTunjangan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tunjangan Keluarga: Rp 0"
            android:textSize="16sp"/>

        <!-- Total -->
        <TextView
            android:id="@+id/tvTotalGaji"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total Gaji: Rp 0"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#4CAF50"
            android:layout_marginTop="15dp"
            android:layout_gravity="center"/>

        <Button
            android:id="@+id/btnKembali"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kembali"
            android:layout_marginTop="20dp"
            android:layout_gravity="center"/>

    </LinearLayout>
</ScrollView>
